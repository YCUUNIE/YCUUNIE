# ---------------------------------------------------------------------------
# AI Agent World — environment variables (SECRETS ONLY)
# Copy this file to `.env` and fill in the providers you want to use.
# The app runs FULLY OFFLINE with no keys at all (provider: local).
# Keys are read server-side only and are NEVER sent to the frontend or logged.
# ---------------------------------------------------------------------------

# Cloud providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_API_KEY=

# Optional endpoint overrides (defaults live in config/config.yaml).
# Local runtimes need no key — just point at them and select the provider
# in config/agents.json.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# LOCALAI_BASE_URL=http://localhost:8080/v1
# CUSTOM_BASE_URL=http://localhost:8000/v1

# Obsidian vault (optional). Empty -> ./obsidian bundled demo vault.
# OBSIDIAN_VAULT_PATH=/absolute/path/to/your/Vault
